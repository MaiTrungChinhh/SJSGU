msgid "plugins.themes.sgu-theme.about.section.1.title"
msgstr "1. Giới thiệu chung"

msgid "plugins.themes.sgu-theme.about.section.1.paragraph.1"
msgstr "Tạp chí Khoa học Đại học Sài Gòn nằm trong hệ thống báo chí chính thống của nước Cộng hòa Xã hội Chủ nghĩa Việt Nam, có tiếng nói khoa học ngang tầm với các Tạp chí khoa học ngành giáo dục và Tạp chí các lĩnh vực khác."

msgid "plugins.themes.sgu-theme.about.section.1.paragraph.2"
msgstr "Tạp chí Khoa học Đại học Sài Gòn có chỉ số Quốc tế ISSN 1859 – 3208, khẳng định Tạp chí đạt tiêu chuẩn Quốc tế về lĩnh vực khoa học. Giáo sư, Phó Giáo sư, Tiến sĩ, Nghiên cứu sinh, Thạc sĩ, Học viên cao học, giảng viên, sinh viên có công trình nghiên cứu khoa học theo đúng nội dung định hướng của Tạp chí, được đăng trên Tạp chí sẽ được tính điểm nghiên cứu khoa học theo quy định."

