msgid "plugins.themes.sgu-theme.about.section.1.title"
msgstr "1. General Introduction"

msgid "plugins.themes.sgu-theme.about.section.1.paragraph.1"
msgstr "The Scientific Journal of Saigon University is part of the official press system of the Socialist Republic of Vietnam, with scientific voice on par with educational science journals and other field journals."

msgid "plugins.themes.sgu-theme.about.section.1.paragraph.2"
msgstr "The Scientific Journal of Saigon University has the International ISSN 1859 - 3208, confirming that the Journal meets international standards in the field of science. Professors, Associate Professors, Doctors, PhD students, Masters, Graduate students, lecturers, and students with scientific research works according to the Journal's orientation will be counted for scientific research points as regulated."

msgid "plugins.themes.sgu-theme.about.section.2.title"
msgstr "2. Journal Name"

msgid "plugins.themes.sgu-theme.about.section.2.vietnamese"
msgstr "Vietnamese name: Tạp chí Khoa học Đại học Sài Gòn."

msgid "plugins.themes.sgu-theme.about.section.2.english"
msgstr "English name: Scientific Journal of Saigon University."

msgid "plugins.themes.sgu-theme.about.section.2.abbreviation"
msgstr "Abbreviation: SJSGU."

msgid "plugins.themes.sgu-theme.about.section.2.address"
msgstr "Address: 273 An Duong Vuong, Ward 3, District 5, Ho Chi Minh City."

msgid "plugins.themes.sgu-theme.about.section.2.contact"
msgstr "Phone: 08.38321360; Email: <a href=\"mailto:tcdhsg@sgu.edu.vn\">tcdhsg@sgu.edu.vn</a>"

msgid "plugins.themes.sgu-theme.about.section.2.seal"
msgstr "The Scientific Journal of Saigon University has its own seal."

msgid "plugins.themes.sgu-theme.about.section.3.title"
msgstr "3. Purpose and Mission"

msgid "plugins.themes.sgu-theme.about.section.3.paragraph.1"
msgstr "The Scientific Journal of Saigon University is a scientific forum publishing research results and scientific activities of staff, lecturers, and students of Saigon University, connecting the university's scientific research with practical production, innovation, and national development."

msgid "plugins.themes.sgu-theme.about.section.3.paragraph.2"
msgstr "The Scientific Journal of Saigon University will be a forum for exchanging thoughts, viewpoints, and research orientations across disciplines between scientists, managers, scholars, and educators at colleges, universities, institutes, academies, and research centers both domestically and internationally; contributing to gradually perfecting and enhancing the training and scientific research functions of Saigon University."

msgid "plugins.themes.sgu-theme.about.section.3.paragraph.3"
msgstr "The Scientific Journal of Saigon University is an important bridge between Saigon University and educational institutions in the national education system, with companies, enterprises, units, and production facilities in the relationship between training and usage, between research and practical economic-social life of the city, region, and country."

